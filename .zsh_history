: 1772132482:0;# --- Script de Diagnóstico do gdtm ---\
GTU_TF_RC_FILE="$HOME/.terraformrc"\
GTU_GITLAB_API_PREFIX="/api/v4/projects"\
GTU_DEFAULT_DOMAIN="gitlab.stoneage.com.br"\
\
echo "1. Lendo Git Remote..."\
remote_url=$(git remote get-url origin 2>/dev/null)\
echo "   -> $remote_url"\
\
echo "2. Extraindo Domínio..."\
git_domain=$(echo "$remote_url" | sed -E 's/.*@([^:]+):.*/\1/; s|https?://([^/]+)/.*|\1|')\
[[ -z "$git_domain" ]] && git_domain=$GTU_DEFAULT_DOMAIN\
echo "   -> $git_domain"\
\
echo "3. Extraindo Project Path..."\
project_path=$(echo "$remote_url" | sed -E "s/.*$git_domain[:\/](.*)(\.git)?$/\1/" | sed 's/\.git$//' | sed 's/\//%2F/g')\
echo "   -> $project_path"\
\
echo "4. Buscando Token..."\
token=$(grep -A 1 "credentials \"$git_domain\"" "$GTU_TF_RC_FILE" 2>/dev/null | grep "token" | cut -d'"' -f2 | tr -d ' ')\
echo "   -> Tamanho do token encontrado: ${#token} caracteres"\
\
echo "5. Montando URL da API..."\
base_api_url="https://${git_domain}${GTU_GITLAB_API_PREFIX}/${project_path}"\
echo "   -> ${base_api_url}/packages?package_type=terraform_module"\
\
echo "6. Chamando a API do GitLab..."\
response=$(curl --silent --header "PRIVATE-TOKEN: $token" "${base_api_url}/packages?package_type=terraform_module")\
echo "   -> Resposta bruta: ${response:0:150}..." # Mostra só os primeiros 150 caracteres para não poluir\
\
echo "7. Tentando extrair os nomes dos módulos..."\
modules=($(echo "$response" | grep -o '"name":"[^"]*"' | cut -d'"' -f4 | sort -u))\
echo "   -> Módulos encontrados: ${modules[@]}"
