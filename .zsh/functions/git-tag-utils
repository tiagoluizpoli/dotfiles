# ==========================================
# Git Tag & GitLab Terraform Utilities
# ==========================================

# --- Configurações Globais ---
GTU_TF_RC_FILE="$HOME/.terraformrc"
GTU_GITLAB_API_PREFIX="/api/v4/projects"
GTU_DEFAULT_DOMAIN="gitlab.stoneage.com.br"

# --- 1. Delete Tags by Pattern (gtd) ---
gtd() {
  if [ $# -eq 0 ]; then
    echo "Usage: gtd <pattern1> [pattern2] ..."
    return 1
  fi

  local pattern tags tag_list
  for pattern in "$@"; do
    tag_list=$(git tag -l "*${pattern}*")
    
    if [[ -z "$tag_list" ]]; then
      echo "No tags found matching: $pattern"
      continue
    fi

    tags=("${(f)tag_list}")
    echo "Found tags matching '*$pattern*':"
    printf " - %s\n" "${tags[@]}"
    
    for t in "${tags[@]}"; do
      echo "Deleting: $t"
      git push origin --delete "$t" 2>/dev/null
      git tag -d "$t"
    done
  done
}

# --- 2. Rename Tag (gtn - Antigo gtr) ---
# Move uma tag de um nome para outro
gtn() {
  if [ $# -ne 2 ]; then
    echo "Usage: gtn <old_tag> <new_tag>"
    return 1
  fi
  git tag "$2" "$1" && git push origin "$2" && git tag -d "$1" && git push origin --delete "$1"
}


# --- 3. Regenerate Tag (gtr) ---
# Deleta a tag local/remota e recria no commit ATUAL
gtr() {
  if [ $# -ne 1 ]; then
    echo "Usage: gtr <tag_name>"
    return 1
  fi

  local tag_name=$1

  echo "Starting reset for tag: $tag_name"
  
  # 1. Deletar local e remoto
  git tag -d "$tag_name" 2>/dev/null
  git push origin --delete "$tag_name" 2>/dev/null

  # 2. Criar novamente no commit atual (HEAD)
  echo "Re-creating '$tag_name' at current HEAD..."
  git tag "$tag_name"
  git push origin "$tag_name"

  echo "Successfully regenerated '$tag_name'!"
}

# --- 4. Delete GitLab Terraform Module by Pattern (gdtm) ---


# --- 4. Delete GitLab Terraform Module by Pattern (gdtm) ---

gdtm() {
  if [ $# -lt 2 ]; then
    echo "Usage: gdtm <module_name> <pattern1> [pattern2] ..."
    return 1
  fi

  local name=$1
  shift # Remove o nome do módulo dos argumentos, deixando apenas os padrões

  # 1. Extrair Domínio e Caminho do git remote
  local remote_url=$(git remote get-url origin 2>/dev/null)
  local git_domain=$(echo "$remote_url" | sed -E 's/.*@([^:]+):.*/\1/; s|https?://([^/]+)/.*|\1|')
  [[ -z "$git_domain" ]] && git_domain=$GTU_DEFAULT_DOMAIN

  local temp_path=${remote_url#*$git_domain}
  temp_path=${temp_path#[:/]}
  temp_path=${temp_path%.git}
  local project_path=${temp_path//\//%2F}

  if [[ -z "$project_path" ]]; then
    echo "Error: Could not determine GitLab project path from git remote."
    return 1
  fi

  # 2. Extrair Token do .terraformrc
  local token=$(grep -A 1 "credentials \"$git_domain\"" "$GTU_TF_RC_FILE" 2>/dev/null | grep "token" | cut -d'"' -f2 | tr -d ' ')
  
  if [[ -z "$token" ]]; then
    echo "Error: Could not find GitLab token for $git_domain in $GTU_TF_RC_FILE"
    return 1
  fi

  # 3. Buscar o ID numérico via API
  local base_api_url="https://${git_domain}${GTU_GITLAB_API_PREFIX}"
  local project_id=$(curl --silent --header "PRIVATE-TOKEN: $token" "${base_api_url}/$project_path" | grep -o '"id":[0-9]*' | head -1 | cut -d':' -f2)

  if [[ -z "$project_id" ]]; then
    echo "Error: Could not fetch Project ID from GitLab API. Check your token/permissions."
    return 1
  fi

  echo "Fetching all available versions for module '$name' (handling pagination)..."
  
  local encoded_name=${name//\//%2F}
  local page=1
  local -a package_lines
  
  # 4. Loop de Paginação: Busca até a API retornar vazio
  while true; do
    local response=$(curl --silent --header "PRIVATE-TOKEN: $token" "${base_api_url}/${project_id}/packages?package_type=terraform_module&package_name=${encoded_name}&per_page=100&page=${page}")

    # Se a resposta for vazia ("[]") ou não contiver versões, sai do loop
    if [[ "$response" == "[]" || "$response" != *"\"version\""* || -z "$response" ]]; then
      break
    fi

    local -a current_lines
    current_lines=(${(f)"$(echo "$response" | sed 's/},{/}\n{/g')"})
    package_lines+=("${current_lines[@]}")
    
    ((page++))
  done

  if [[ ${#package_lines[@]} -eq 0 ]]; then
    echo "No versions found for module '$name' in GitLab Registry."
    return 1
  fi

  # 5. Iterar sobre os padrões fornecidos
  local pattern
  for pattern in "$@"; do
    local -a matched_versions
    
    # Pre-listagem visual para o usuário
    for line in "${package_lines[@]}"; do
      local v=$(echo "$line" | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
      if [[ "$v" == *"$pattern"* ]]; then
        matched_versions+=("$v")
      fi
    done

    if [[ ${#matched_versions[@]} -eq 0 ]]; then
      echo "No versions found matching '*${pattern}*' for module '$name'."
      continue
    fi

    echo "Found versions matching '*${pattern}*':"
    printf " - %s\n" "${matched_versions[@]}"

    # Loop real de deleção baseado no ID do pacote
    for line in "${package_lines[@]}"; do
      local v=$(echo "$line" | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
      
      if [[ "$v" == *"$pattern"* ]]; then
        local pkg_id=$(echo "$line" | grep -o '"id":[0-9]*' | head -1 | cut -d':' -f2)
        
        echo "Deleting '$name' version '$v'..."
        
        local delete_url="${base_api_url}/${project_id}/packages/${pkg_id}"
        local del_response=$(curl --request DELETE --header "PRIVATE-TOKEN: ${token}" --write-out "%{http_code}" --silent --output /dev/null "$delete_url")

        if [[ "$del_response" == "204" || "$del_response" == "200" ]]; then
          echo "  -> Successfully deleted $v."
        else
          echo "  -> Failed to delete $v. GitLab API returned HTTP: $del_response"
        fi
      fi
    done
  done
  
  echo "Done!"
}

# --- Autocomplete ---
_git_tag_utils_complete() {
    local -a tags
    # Obtém a lista de tags e limpa espaços
    tags=(${(f)"$(git tag 2>/dev/null)"})
    
    if (( $#tags > 0 )); then
        _describe 'tags' tags
    fi
}

_gdtm_complete() {
    exec 2>/dev/null 

    local remote_url=$(git remote get-url origin 2>/dev/null)
    local git_domain=$(echo "$remote_url" | sed -E 's/.*@([^:]+):.*/\1/; s|https?://([^/]+)/.*|\1|')
    [[ -z "$git_domain" ]] && git_domain=$GTU_DEFAULT_DOMAIN
    
    local temp_path=${remote_url#*$git_domain}
    temp_path=${temp_path#[:/]}
    temp_path=${temp_path%.git}
    local project_path=${temp_path//\//%2F}

    [[ -z "$project_path" ]] && return

    local token=$(grep -A 1 "credentials \"$git_domain\"" "$GTU_TF_RC_FILE" 2>/dev/null | grep "token" | cut -d'"' -f2 | tr -d ' ')
    [[ -z "$token" ]] && return

    local base_api_url="https://${git_domain}${GTU_GITLAB_API_PREFIX}"

    # Adicionado &per_page=100 para trazer uma lista muito mais rica no Tab
    if [[ CURRENT -eq 2 ]]; then
        local response=$(curl --silent --header "PRIVATE-TOKEN: $token" "${base_api_url}/$project_path/packages?package_type=terraform_module&per_page=100")
        local -a modules
        modules=(${(f)"$(echo "$response" | grep -o '"name":"[^"]*"' | cut -d'"' -f4 | grep -v ' ' | sort -u)"})
        
        if [[ ${#modules[@]} -gt 0 ]]; then
            _describe 'terraform modules' modules
        fi
    elif [[ CURRENT -ge 3 ]]; then
        local module_name="${words[2]}"
        local encoded_name=${module_name//\//%2F}
        local response=$(curl --silent --header "PRIVATE-TOKEN: $token" "${base_api_url}/$project_path/packages?package_type=terraform_module&package_name=${encoded_name}&per_page=100")
        local -a versions
        versions=(${(f)"$(echo "$response" | grep -o '"version":"[^"]*"' | cut -d'"' -f4 | grep -v ' ' | sort -u)"})
        
        if [[ ${#versions[@]} -gt 0 ]]; then
            _describe 'module versions' versions
        fi
    fi
}


compdef _git_tag_utils_complete gtd gtn gtr
compdef _gdtm_complete gdtm